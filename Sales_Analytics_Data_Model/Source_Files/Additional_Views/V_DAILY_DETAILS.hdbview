VIEW "V_DAILY_DETAILS" (IN IN_DATE DATE) AS
SELECT s.SALE_ID,
  d.CAL_DATE,
  s.AMOUNT,
  c.CUSTOMER_NAME,
  LAST_DAY(d.CAL_DATE) AS MONTH_END_DATE,
  TO_VARCHAR(d.CAL_DATE, 'DAY') AS WEEKDAY_NAME
FROM FACT_SALES s
  JOIN DIM_CUSTOMER c ON s.CUSTOMER_ID = c.CUSTOMER_ID
  JOIN DIM_DATE d ON s.DATE_ID = d.DATE_ID
  WHERE d.CAL_DATE = :IN_DATE;