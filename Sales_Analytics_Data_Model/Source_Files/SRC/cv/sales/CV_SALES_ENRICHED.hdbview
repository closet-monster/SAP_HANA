VIEW "CV_SALES_ENRICHED" AS
SELECT
    fs.SALE_ID,
    fs.SALE_ITEM_ID,
	fs.SALE_TIMESTAMP,
    fs.DATE_ID,
    d.CAL_DATE,
    d.YEAR,
    d.MONTH,
    s.STORE_ID,
    s.STORE_NAME,
    s.LOCATION AS STORE_LOCATION,
    s.COUNTRY AS STORE_COUNTRY,
    s.REGION AS STORE_REGION,
    s.MANAGER AS STORE_MANAGER,
    c.CUSTOMER_ID,
    c.CUSTOMER_NAME,
    c.SEGMENT AS CUSTOMER_SEGMENT,
    c.LOYALTY_STATUS AS CUSTOMER_LOYALTY_STATUS,
    p.PRODUCT_ID,
    p.PRODUCT_NAME,
    p.CATEGORY,
    p.SUBCATEGORY,
    fs.QUANTITY,
    fs.PRICE,
    fs.DISCOUNT_PCT,
    (fs.QUANTITY * fs.PRICE * (1 - fs.DISCOUNT_PCT)) AS NET_SALES,
    (fs.QUANTITY * p.COST) AS COGS,
    (fs.QUANTITY * fs.PRICE * (1 - fs.DISCOUNT_PCT)) - (fs.QUANTITY *
    p.COST) AS GROSS_MARGIN,
    fs.CURRENCY
FROM FACT_SALES fs
LEFT JOIN DIM_CUSTOMER c ON c.CUSTOMER_ID = fs.CUSTOMER_ID
LEFT JOIN DIM_DATE d ON d.DATE_ID = fs.DATE_ID
LEFT JOIN DIM_PRODUCT p ON p.PRODUCT_ID = fs.PRODUCT_ID
LEFT JOIN DIM_STORE s ON s.STORE_ID = fs.STORE_ID;